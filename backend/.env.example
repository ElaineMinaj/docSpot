# Copy this file to .env (same folder) and paste ONE key after the =
# .env is gitignored, so the key never gets committed.
# If both are set, OpenAI is used.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini

ANTHROPIC_API_KEY=
# CLAUDE_MODEL=claude-opus-5

# Consent emails (optional). Gmail account that sends, its app password, and the demo patient's inbox.
# Without these, the consent form still works and the app shows the secure link instead of emailing it.
SMTP_USER=
SMTP_APP_PASSWORD=
DEMO_PATIENT_EMAIL=
# PUBLIC_BASE_URL=https://your-tunnel-address   (so the email link opens on a phone)

# Resend API key (preferred for consent emails). Without a verified domain it only sends to your Resend account email.
RESEND_API_KEY=
# RESEND_FROM=DocSpot for Dr. Anna Lee <onboarding@resend.dev>
